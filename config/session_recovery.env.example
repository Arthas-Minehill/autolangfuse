# 复制为 session_recovery.env 后填写。该本地文件已被 .gitignore 忽略。

# Langfuse API。脚本实际访问 API 时只使用 Host、Project ID 和两把 Key。
LANGFUSE_HOST=https://langfuse.lecangs.com
LANGFUSE_PROJECT_ID=cmpmf51m20025wz07k01zzhlx
LANGFUSE_PROJECT_NAME=lecangs_data_analysis_user
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_QUEUE_NAME=数据回收-准入审核-POC
LANGFUSE_QUEUE_ID=cmttgy6sr001uzm07qn9ge7x7

# 仅供同事手工登录网页时查阅，脚本不会自动提交账号密码。
LANGFUSE_LOGIN_EMAIL=
LANGFUSE_LOGIN_PASSWORD=

# OpenAI-compatible Chat Completions API。
# 示例：https://api.openai.com/v1；内网代理请填写代理提供的 /v1 地址。
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=180
AI_MAX_SESSION_CHARS=60000
AI_JSON_MODE=true

# 工作流默认值。
SESSION_TIMEZONE_OFFSET=+08:00
SESSION_DEFAULT_DAYS=7
SESSION_DEFAULT_LIMIT=10
SESSION_OUTPUT_ROOT=results/session_recovery
AI_REVIEW_PROMPT_FILE=config/ai_review_prompt.md
