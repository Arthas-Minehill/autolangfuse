# Langfuse
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_DATASET_NAME=aieval/real_cases

# AIEval run metadata
AIEVAL_RUN_ID=
AIEVAL_AGENT_VERSION=agent-v0
AIEVAL_CLIENT=codex-desktop
AIEVAL_SKILL_VERSION=skill-v0
AIEVAL_DB_SNAPSHOT_ID=snapshot-v0
AIEVAL_LIMIT=0
AIEVAL_ITEM_ID=

# Runner input
AIEVAL_ITEMS_JSON=

# Codex app-server runner
AIEVAL_CODEX_BIN=
AIEVAL_CODEX_CWD=
AIEVAL_CODEX_MODEL=
AIEVAL_CODEX_SANDBOX=workspace-write
AIEVAL_APP_SERVER_REQUEST_TIMEOUT_SECONDS=90
AIEVAL_APP_SERVER_TURN_TIMEOUT_SECONDS=1800
AIEVAL_MAPPING_PATH=
AIEVAL_MAPPING_TIMEOUT_SECONDS=90
